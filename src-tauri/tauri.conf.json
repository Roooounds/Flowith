{
  "$schema": "https://raw.githubusercontent.com/nickolay/tauri-docs/refs/heads/v2/src/content/docs/_schema/config.schema.json",
  "productName": "Flowith",
  "version": "1.0.0",
  "identifier": "com.flowith.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "launcher",
        "title": "Flowith Setup",
        "url": "launcher.html",
        "width": 1024,
        "height": 750,
        "minWidth": 900,
        "minHeight": 700,
        "resizable": true,
        "decorations": true,
        "center": true,
        "visible": true
      },
      {
        "label": "main",
        "title": "Flowith - AI Workflow Manager",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 680,
        "resizable": true,
        "decorations": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {},
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
